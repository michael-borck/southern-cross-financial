{% extends "base.html.j2" %}

{% block title %}{{ job.title }} — Southern Cross Financial{% endblock %}

{% block content %}
<section class="section-pad">
    <div class="wrap-narrow">
        <p class="eyebrow"><a href="/careers.html" style="color: var(--sc-brass-deep);">← All positions</a></p>
        <h1 style="margin-bottom: var(--sc-px-4); font-style: italic;">{{ job.title }}</h1>
        <p class="lead" style="font-size: 1.2rem;">{{ job.brief or job.summary or "" }}</p>

        <hr class="rule-double" style="max-width: 200px; margin: var(--sc-px-6) 0;">

        <div class="services-list" style="border: none;">
            <div class="service-row" style="border: none; padding: var(--sc-px-2) 0;">
                <div class="service-num" style="font-size: 1rem;">·</div>
                <div>
                    <div class="service-title" style="font-size: 1.05rem;">Department</div>
                </div>
                <div class="service-meta">{{ job.department or "—" }}</div>
            </div>
            <div class="service-row" style="border: none; padding: var(--sc-px-2) 0;">
                <div class="service-num" style="font-size: 1rem;">·</div>
                <div>
                    <div class="service-title" style="font-size: 1.05rem;">Employment type</div>
                </div>
                <div class="service-meta">{{ job.employment_type or "Full-time" }}</div>
            </div>
            {% if job.reports_to %}
            <div class="service-row" style="border: none; padding: var(--sc-px-2) 0;">
                <div class="service-num" style="font-size: 1rem;">·</div>
                <div>
                    <div class="service-title" style="font-size: 1.05rem;">Reports to</div>
                </div>
                <div class="service-meta">{{ job.reports_to }}</div>
            </div>
            {% endif %}
            <div class="service-row" style="border: none; padding: var(--sc-px-2) 0;">
                <div class="service-num" style="font-size: 1rem;">·</div>
                <div>
                    <div class="service-title" style="font-size: 1.05rem;">Location</div>
                </div>
                <div class="service-meta">Perth, Western Australia</div>
            </div>
        </div>
    </div>
</section>

<section class="section-pad" style="background: var(--sc-bg-2); border-top: 1px solid var(--sc-line); border-bottom: 1px solid var(--sc-line);">
    <div class="wrap-narrow">
        {% if job.description %}
        <article class="prose">
            {{ job.description | markdown }}
        </article>
        {% endif %}
    </div>
</section>

<section class="apply-section" id="apply">
    <div class="wrap-narrow">
        <p class="eyebrow">Apply for this role</p>
        <h2 style="font-style: italic;">We would like to hear from you.</h2>
        <p class="lead">Submit your CV and a short cover letter. We read every application and respond personally within five business days.</p>

        <form id="apply-form" class="apply-form" data-api-base="https://workready-api.eduserver.au">
            <input type="hidden" name="posting_id" value="">
            <input type="hidden" name="job_title" value="{{ job.title }}">
            <div>
                <label for="applicant_name">Full name <span class="apply-required">*</span></label>
                <input type="text" name="applicant_name" id="applicant_name" required>
            </div>
            <div>
                <label for="applicant_email">Email address <span class="apply-required">*</span></label>
                <input type="email" name="applicant_email" id="applicant_email" required placeholder="firstname.lastname@student.curtin.edu.au">
            </div>
            <div>
                <label for="cover_letter">Cover letter</label>
                <textarea name="cover_letter" id="cover_letter" rows="5" placeholder="Tell us why you're a good fit for this role…"></textarea>
            </div>
            <div>
                <label for="resume">Resume (PDF) <span class="apply-required">*</span></label>
                <input type="file" name="resume" id="resume" accept=".pdf" required>
            </div>
            <div>
                <button type="submit" class="btn btn-brass btn-arrow">Submit application</button>
            </div>
            <div id="apply-result" class="apply-result"></div>
        </form>
    </div>
</section>
{% endblock %}

{% block head_extra %}
<script src="/scripts/apply.js" defer></script>
{% endblock %}
